PORT=8080
ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (postgres or sqlite)
DB_DRIVER=sqlite
DB_DSN=data/auth.db
# For PostgreSQL in Docker:
# DB_DRIVER=postgres
# DB_DSN=postgres://postgres:postgrespassword@localhost:5432/uidesign?sslmode=disable

# JWT Secret & Expiry
JWT_SECRET=super-secret-jwt-signing-key-change-in-production-12345
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h # 7 days
REFRESH_TOKEN_REMEMBER_TTL=720h # 30 days
ROTATION_GRACE_PERIOD=30s

# Mail / Mailpit Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="no-reply@uidesign.local"
APP_BASE_URL=http://localhost:5173

# File Uploads
UPLOAD_DIR=./uploads
# Existing account to promote to admin when the server starts.
# ADMIN_EMAIL=admin@example.com
